{
  "protocolVersion": 1,
  "plugin": {
    "publisher": "example",
    "id": "text-support",
    "version": "0.1.0"
  },
  "permissions": [
    {
      "kind": "captured-input"
    }
  ],
  "components": [
    {
      "id": "worker",
      "scope": "project",
      "runtime": "javascript",
      "entrypoint": "component.mjs",
      "dependencies": [],
      "exit": {
        "stopTimeoutMs": 1000,
        "cleanupTimeoutMs": 1000
      }
    }
  ],
  "contributions": [
    {
      "id": "text-review-profile",
      "componentId": "worker",
      "contribution": {
        "kind": "resource",
        "schema": {
          "id": "tsumugi.text-review-declaration",
          "schemaVersion": 1,
          "behaviorVersion": 1
        },
        "path": "review/text.json"
      }
    },
    {
      "id": "terms",
      "componentId": "worker",
      "contribution": {
        "kind": "resource",
        "schema": {
          "id": "example.editorial-resource",
          "schemaVersion": 1,
          "behaviorVersion": 1
        },
        "path": "resources/terms.json"
      }
    },
    {
      "id": "text-review-check",
      "componentId": "worker",
      "contribution": {
        "kind": "capability",
        "declaration": {
          "contract": {
            "id": "example.text-review",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "inputSchema": {
            "id": "tsumugi.text-review-input",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "outputSchema": {
            "id": "tsumugi.text-review-report",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "errorSchema": {
            "id": "tsumugi.review-check-error",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "profiles": [
            {
              "id": "example.editorial-text",
              "schemaVersion": 1,
              "behaviorVersion": 1
            }
          ],
          "effect": "read-only",
          "permissions": [
            {
              "kind": "captured-input"
            }
          ],
          "limits": {
            "maxInputBytes": 4194304,
            "maxOutputBytes": 2097152,
            "concurrency": 1,
            "timeoutMs": 5000
          }
        }
      }
    }
  ]
}
