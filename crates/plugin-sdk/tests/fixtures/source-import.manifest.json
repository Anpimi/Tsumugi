{
  "protocolVersion": 1,
  "plugin": {
    "publisher": "example",
    "id": "plain-text",
    "version": "0.1.0"
  },
  "permissions": [
    {
      "kind": "captured-input"
    }
  ],
  "components": [
    {
      "id": "worker",
      "scope": "project",
      "runtime": "javascript",
      "entrypoint": "component.mjs",
      "dependencies": [],
      "exit": {
        "stopTimeoutMs": 1000,
        "cleanupTimeoutMs": 1000
      }
    }
  ],
  "contributions": [
    {
      "id": "source-profile",
      "componentId": "worker",
      "contribution": {
        "kind": "resource",
        "schema": {
          "id": "tsumugi.source-import-declaration",
          "schemaVersion": 2,
          "behaviorVersion": 2
        },
        "path": "source-profile.json"
      }
    },
    {
      "id": "extract",
      "componentId": "worker",
      "contribution": {
        "kind": "capability",
        "declaration": {
          "contract": {
            "id": "example.extract",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "inputSchema": {
            "id": "tsumugi.source-extraction-input",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "outputSchema": {
            "id": "tsumugi.content-exchange",
            "schemaVersion": 2,
            "behaviorVersion": 1
          },
          "errorSchema": {
            "id": "tsumugi.source-extraction-error",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "profiles": [
            {
              "id": "example.plain-text",
              "schemaVersion": 1,
              "behaviorVersion": 1
            }
          ],
          "effect": "proposal",
          "permissions": [
            {
              "kind": "captured-input"
            }
          ],
          "limits": {
            "maxInputBytes": 2097152,
            "maxOutputBytes": 2097152,
            "concurrency": 1,
            "timeoutMs": 30000
          }
        }
      }
    },
    {
      "id": "source-check",
      "componentId": "worker",
      "contribution": {
        "kind": "capability",
        "declaration": {
          "contract": {
            "id": "example.source-check",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "inputSchema": {
            "id": "tsumugi.source-extraction-check-input",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "outputSchema": {
            "id": "tsumugi.check-results",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "errorSchema": {
            "id": "tsumugi.source-extraction-error",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "profiles": [
            {
              "id": "example.plain-text",
              "schemaVersion": 1,
              "behaviorVersion": 1
            }
          ],
          "effect": "read-only",
          "permissions": [
            {
              "kind": "captured-input"
            }
          ],
          "limits": {
            "maxInputBytes": 4194304,
            "maxOutputBytes": 2097152,
            "concurrency": 1,
            "timeoutMs": 30000
          }
        }
      }
    },
    {
      "id": "review-check",
      "componentId": "worker",
      "contribution": {
        "kind": "capability",
        "declaration": {
          "contract": {
            "id": "example.review-check",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "inputSchema": {
            "id": "tsumugi.review-check-input",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "outputSchema": {
            "id": "tsumugi.check-results",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "errorSchema": {
            "id": "tsumugi.review-check-error",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "profiles": [
            {
              "id": "example.plain-text",
              "schemaVersion": 1,
              "behaviorVersion": 1
            }
          ],
          "effect": "read-only",
          "permissions": [
            {
              "kind": "captured-input"
            }
          ],
          "limits": {
            "maxInputBytes": 4194304,
            "maxOutputBytes": 2097152,
            "concurrency": 1,
            "timeoutMs": 30000
          }
        }
      }
    },
    {
      "id": "review-profile",
      "componentId": "worker",
      "contribution": {
        "kind": "resource",
        "schema": {
          "id": "tsumugi.review-declaration",
          "schemaVersion": 1,
          "behaviorVersion": 1
        },
        "path": "review-profile.json"
      }
    }
  ]
}
