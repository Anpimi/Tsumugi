{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceImportDeclaration",
  "description": "Fixed materials and explicitly chosen file sets share one captured input.",
  "type": "object",
  "properties": {
    "checker": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "extractor": {
      "type": "string"
    },
    "fileSets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceFileSetDeclaration"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceMaterialDeclaration"
      }
    },
    "maxTotalBytes": {
      "description": "v5 caps the sum of actual captured bytes, independently of the per-file\nceilings. Absence retains the exact v2/v3/v4 reservation semantics.",
      "type": "integer",
      "maximum": 2097152,
      "minimum": 1
    },
    "profile": {
      "$ref": "#/$defs/ContractRef"
    },
    "reviewResource": {
      "description": "Exact immutable Resource whose domain rules are adopted with this source.",
      "type": "string"
    },
    "revisionPolicy": {
      "$ref": "#/$defs/SourceRevisionPolicy"
    },
    "semanticRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContractRef"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "displayName",
    "profile",
    "materials",
    "extractor",
    "checker",
    "reviewResource",
    "revisionPolicy",
    "semanticRules",
    "fileSets",
    "maxTotalBytes"
  ],
  "$defs": {
    "ContractRef": {
      "description": "Schema and behavior are separate exact-match compatibility identities.\nMatching JSON field types or a package SemVer is not behavioral compatibility.",
      "type": "object",
      "properties": {
        "behaviorVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "behaviorVersion"
      ]
    },
    "SourceFileSetDeclaration": {
      "description": "Explicit user choices within one authorized root. No glob, directory scan,\nabsolute path, or permission is part of this declaration or its resolution.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/SourceMaterialEncoding"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "maxBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxFiles": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minFiles": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "role",
        "encoding",
        "extensions",
        "minFiles",
        "maxFiles",
        "maxBytes"
      ]
    },
    "SourceMaterialDeclaration": {
      "type": "object",
      "properties": {
        "encoding": {
          "$ref": "#/$defs/SourceMaterialEncoding"
        },
        "logicalPath": {
          "type": "string"
        },
        "maxBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "logicalPath",
        "role",
        "maxBytes",
        "encoding"
      ]
    },
    "SourceMaterialEncoding": {
      "type": "string",
      "enum": [
        "utf8",
        "binary"
      ]
    },
    "SourceRevisionPolicy": {
      "description": "Captured by the trusted policy owner before a proposal is received. Only\nthese exact block schemas contribute opaque bytes to source revisions.",
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/ContractRef"
        },
        "revisionBasis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContractRef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "revisionBasis"
      ]
    }
  }
}
