{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceExtractionTypes",
  "type": "object",
  "properties": {
    "content": {
      "$ref": "#/$defs/ContentExchange"
    },
    "error": {
      "$ref": "#/$defs/SourceExtractionError"
    },
    "input": {
      "$ref": "#/$defs/SourceExtractionInput"
    }
  },
  "required": [
    "input",
    "content",
    "error"
  ],
  "$defs": {
    "CapturedTextArtifact": {
      "description": "Captured UTF-8 bytes, including a BOM and original line endings. These are\nimmutable source evidence; logical paths are not local filesystem authority.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "logicalPath": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "utf8": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "logicalPath",
        "role",
        "sha256",
        "utf8"
      ]
    },
    "ContentExchange": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapturedTextArtifact"
          }
        },
        "domainBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DomainBlock"
          }
        },
        "order": {
          "description": "Exact occurrence order. Hierarchies and other graphs use typed relations.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profile": {
          "$ref": "#/$defs/ContractRef"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentRelation"
          }
        },
        "sourceLanguage": {
          "type": "string"
        },
        "sourceSetId": {
          "type": "string"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentUnit"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "sourceSetId",
        "sourceLanguage",
        "artifacts",
        "units",
        "order",
        "relations",
        "domainBlocks"
      ]
    },
    "ContentOccurrence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "nativeIdentity": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeIdentityEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ]
    },
    "ContentRelation": {
      "type": "object",
      "properties": {
        "fromOccurrence": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ContractRef"
        },
        "toOccurrence": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "fromOccurrence",
        "toOccurrence"
      ]
    },
    "ContentTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "snapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "unit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "occurrence"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "ContentUnit": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Operation-local reference or a captured project identity, as specified by\nthe capability. A plugin cannot allocate authoritative project revisions.",
          "type": "string"
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentOccurrence"
          }
        },
        "protectedFragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProtectedFragment"
          }
        },
        "sourceRevisionId": {
          "description": "During extraction this is an operation-local proposal reference. Only\nCore may map it to an authoritative project source revision.",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "sourceRevisionId",
        "text",
        "occurrences",
        "protectedFragments"
      ]
    },
    "ContractRef": {
      "description": "Schema and behavior are separate exact-match compatibility identities.\nMatching JSON field types or a package SemVer is not behavioral compatibility.",
      "type": "object",
      "properties": {
        "behaviorVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "behaviorVersion"
      ]
    },
    "DomainBlock": {
      "type": "object",
      "properties": {
        "handling": {
          "$ref": "#/$defs/ExtensionHandling"
        },
        "payloadUtf8": {
          "description": "Exact UTF-8 payload, intentionally not an open JSON property bag. Its\nschema is interpreted by the domain, without loss through Value parsing.",
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/ContractRef"
        },
        "target": {
          "$ref": "#/$defs/ContentTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "schema",
        "handling",
        "payloadUtf8"
      ]
    },
    "ExtensionHandling": {
      "oneOf": [
        {
          "description": "An operation that needs this block must have the exact interpreter.",
          "type": "string",
          "const": "required"
        },
        {
          "description": "Preserve the payload exactly, including when its schema is understood.",
          "type": "string",
          "const": "preserve"
        },
        {
          "description": "Interpretation is optional; an unknown payload is still preserved.",
          "type": "string",
          "const": "optional"
        }
      ]
    },
    "NativeIdentityEvidence": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/ContractRef"
        },
        "value": {
          "description": "The domain's canonical matching value, not necessarily its original\nliteral spelling. Literal identity and semantic revision evidence belong\nin versioned domain blocks; Core does not normalize this value again.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "namespace",
        "value",
        "policy"
      ]
    },
    "ProtectedFragment": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ContractRef"
        },
        "range": {
          "description": "Coordinates into the decoded unit text, not its original artifact.",
          "$ref": "#/$defs/TextRange"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "range"
      ]
    },
    "SourceExtractionError": {
      "description": "A bounded public diagnostic. Producers must use public descriptions and\ncaptured artifact IDs, never local paths, raw source text or secrets. Data\nvalidation cannot establish that arbitrary diagnostic text is safe to share.",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "$ref": "#/$defs/SourceExtractionErrorCode"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ]
    },
    "SourceExtractionErrorCode": {
      "description": "Finite public failure classifications; details never determine permissions.",
      "type": "string",
      "enum": [
        "invalid-input",
        "unsupported-profile",
        "invalid-source",
        "unsupported-structure",
        "limit-exceeded",
        "cancelled"
      ]
    },
    "SourceExtractionInput": {
      "description": "Raw captured UTF-8 material supplied for one selected extraction profile.\nLogical paths and artifact IDs carry no filesystem or execution authority.\nThis input contains no authoritative project unit or source revision IDs.",
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapturedTextArtifact"
          }
        },
        "profile": {
          "$ref": "#/$defs/ContractRef"
        },
        "sourceLanguage": {
          "type": "string"
        },
        "sourceSetId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "sourceSetId",
        "sourceLanguage",
        "artifacts"
      ]
    },
    "SourceReference": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/TextRange"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifactId",
        "range"
      ]
    },
    "TextEncoding": {
      "type": "string",
      "enum": [
        "utf8-byte",
        "utf16",
        "grapheme"
      ]
    },
    "TextRange": {
      "description": "Half-open offsets into one exact string, never between different strings.",
      "type": "object",
      "properties": {
        "encoding": {
          "$ref": "#/$defs/TextEncoding"
        },
        "end": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "encoding",
        "start",
        "end"
      ]
    }
  }
}
