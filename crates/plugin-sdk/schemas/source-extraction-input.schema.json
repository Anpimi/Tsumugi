{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceExtractionInput",
  "description": "Raw captured text or binary material for one selected extraction profile.\nLogical paths and artifact IDs carry no filesystem or execution authority.\nThis input contains no authoritative project unit or source revision IDs.",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CapturedArtifact"
      }
    },
    "profile": {
      "$ref": "#/$defs/ContractRef"
    },
    "sourceLanguage": {
      "type": "string"
    },
    "sourceSetId": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "profile",
    "sourceSetId",
    "sourceLanguage",
    "artifacts"
  ],
  "$defs": {
    "CapturedArtifact": {
      "description": "Exactly one representation. Text retains its original wire shape; mixed,\nnull and unknown fields are rejected by the two closed representations.",
      "anyOf": [
        {
          "$ref": "#/$defs/CapturedTextArtifact"
        },
        {
          "$ref": "#/$defs/CapturedBinaryArtifact"
        }
      ]
    },
    "CapturedBinaryArtifact": {
      "description": "Canonical padded RFC 4648 base64 of the original bytes. The digest describes\nthe decoded bytes, never their transport encoding. Decoding is domain-owned.",
      "type": "object",
      "properties": {
        "base64": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "logicalPath": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "logicalPath",
        "role",
        "sha256",
        "base64"
      ]
    },
    "CapturedTextArtifact": {
      "description": "Exact UTF-8 bytes, including BOMs and original line endings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "logicalPath": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "utf8": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "logicalPath",
        "role",
        "sha256",
        "utf8"
      ]
    },
    "ContractRef": {
      "description": "Schema and behavior are separate exact-match compatibility identities.\nMatching JSON field types or a package SemVer is not behavioral compatibility.",
      "type": "object",
      "properties": {
        "behaviorVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "behaviorVersion"
      ]
    }
  }
}
