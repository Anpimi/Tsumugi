{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityToolDeclaration",
  "description": "A package-local adapter to one declared, read-only capability. Input/output\ncontracts, limits and permissions are taken from that capability, rather\nthan repeated in a model-specific descriptor. A profile is an exact choice.",
  "type": "object",
  "properties": {
    "capabilityId": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContractRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "skill": {
      "type": [
        "string",
        "null"
      ]
    },
    "supportingResources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "title",
    "description",
    "capabilityId",
    "supportingResources"
  ],
  "$defs": {
    "ContractRef": {
      "description": "Schema and behavior are separate exact-match compatibility identities.\nMatching JSON field types or a package SemVer is not behavioral compatibility.",
      "type": "object",
      "properties": {
        "behaviorVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "behaviorVersion"
      ]
    }
  }
}
