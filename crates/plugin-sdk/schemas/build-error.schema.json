{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuildError",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": [
        "string",
        "null"
      ]
    },
    "code": {
      "$ref": "#/$defs/BuildErrorCode"
    },
    "detail": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "code",
    "detail"
  ],
  "$defs": {
    "BuildErrorCode": {
      "type": "string",
      "enum": [
        "invalid-input",
        "unsupported-profile",
        "invalid-target",
        "invalid-artifact",
        "limit-exceeded",
        "cancelled"
      ]
    }
  }
}
