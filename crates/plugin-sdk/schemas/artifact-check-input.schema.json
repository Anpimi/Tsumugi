{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactCheckInput",
  "type": "object",
  "properties": {
    "input": {
      "$ref": "#/$defs/BuildInput"
    },
    "output": {
      "$ref": "#/$defs/ArtifactSet"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CheckRequirement"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "input",
    "output",
    "requirements"
  ],
  "$defs": {
    "ArtifactSet": {
      "description": "Actual UTF-8 output, including BOM and line endings. This contract deliberately\nmakes no binary-artifact or domain conformance claim. No local paths are used.",
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapturedTextArtifact"
          }
        },
        "profile": {
          "$ref": "#/$defs/ContractRef"
        },
        "sourceSetId": {
          "type": "string"
        },
        "targetLanguage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "sourceSetId",
        "targetLanguage",
        "artifacts"
      ]
    },
    "BuildInput": {
      "type": "object",
      "properties": {
        "configuration": {
          "description": "Exact domain configuration; an empty collection means no configuration.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EncodedPayload"
          }
        },
        "outputLimits": {
          "description": "Captured by the trusted planner, never replaced by returned artifacts.",
          "$ref": "#/$defs/BuildOutputLimits"
        },
        "outputPaths": {
          "description": "Complete authorized relative output paths, fixed before dispatch.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/$defs/ContentExchange"
        },
        "targetLanguage": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BuildTarget"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "targetLanguage",
        "targets",
        "configuration",
        "outputPaths",
        "outputLimits"
      ]
    },
    "BuildOutputLimits": {
      "type": "object",
      "properties": {
        "maxArtifacts": {
          "type": "integer",
          "maximum": 32,
          "minimum": 1
        },
        "maxTotalBytes": {
          "type": "integer",
          "maximum": 2097152,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "maxArtifacts",
        "maxTotalBytes"
      ]
    },
    "BuildTarget": {
      "description": "One already decided text per source unit, even when it has many occurrences.\nNo candidate selection, review decision or project write handle is supplied.",
      "type": "object",
      "properties": {
        "sourceRevisionId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "unitId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "unitId",
        "sourceRevisionId",
        "text"
      ]
    },
    "CapturedTextArtifact": {
      "description": "Captured UTF-8 bytes, including a BOM and original line endings. These are\nimmutable source evidence; logical paths are not local filesystem authority.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "logicalPath": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "utf8": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "logicalPath",
        "role",
        "sha256",
        "utf8"
      ]
    },
    "CheckImplementation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "core"
            },
            "validator": {
              "$ref": "#/$defs/ContractRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "validator"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plugin"
            },
            "provider": {
              "$ref": "#/$defs/ProviderSelectionBinding"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "provider"
          ]
        }
      ]
    },
    "CheckKey": {
      "type": "object",
      "properties": {
        "implementation": {
          "$ref": "#/$defs/CheckImplementation"
        },
        "rule": {
          "$ref": "#/$defs/ContractRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "rule",
        "implementation"
      ]
    },
    "CheckRequirement": {
      "type": "object",
      "properties": {
        "inputDigest": {
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/CheckKey"
        },
        "mandatory": {
          "type": "boolean"
        },
        "notApplicable": {
          "anyOf": [
            {
              "$ref": "#/$defs/NotApplicableBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopeDigest": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waivable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "inputDigest",
        "scopeDigest",
        "targets",
        "mandatory",
        "waivable"
      ]
    },
    "ContentExchange": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapturedTextArtifact"
          }
        },
        "domainBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DomainBlock"
          }
        },
        "order": {
          "description": "Exact occurrence order. Hierarchies and other graphs use typed relations.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profile": {
          "$ref": "#/$defs/ContractRef"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentRelation"
          }
        },
        "sourceLanguage": {
          "type": "string"
        },
        "sourceSetId": {
          "type": "string"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentUnit"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "sourceSetId",
        "sourceLanguage",
        "artifacts",
        "units",
        "order",
        "relations",
        "domainBlocks"
      ]
    },
    "ContentOccurrence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "nativeIdentity": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeIdentityEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ]
    },
    "ContentRelation": {
      "type": "object",
      "properties": {
        "fromOccurrence": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ContractRef"
        },
        "toOccurrence": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "fromOccurrence",
        "toOccurrence"
      ]
    },
    "ContentTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "snapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "unit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "occurrence"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "ContentUnit": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Operation-local reference or a captured project identity, as specified by\nthe capability. A plugin cannot allocate authoritative project revisions.",
          "type": "string"
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentOccurrence"
          }
        },
        "protectedFragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProtectedFragment"
          }
        },
        "sourceRevisionId": {
          "description": "During extraction this is an operation-local proposal reference. Only\nCore may map it to an authoritative project source revision.",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "sourceRevisionId",
        "text",
        "occurrences",
        "protectedFragments"
      ]
    },
    "ContractRef": {
      "description": "Schema and behavior are separate exact-match compatibility identities.\nMatching JSON field types or a package SemVer is not behavioral compatibility.",
      "type": "object",
      "properties": {
        "behaviorVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "behaviorVersion"
      ]
    },
    "DomainBlock": {
      "type": "object",
      "properties": {
        "handling": {
          "$ref": "#/$defs/ExtensionHandling"
        },
        "payloadUtf8": {
          "description": "Exact UTF-8 payload, intentionally not an open JSON property bag. Its\nschema is interpreted by the domain, without loss through Value parsing.",
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/ContractRef"
        },
        "target": {
          "$ref": "#/$defs/ContentTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "schema",
        "handling",
        "payloadUtf8"
      ]
    },
    "EncodedPayload": {
      "description": "Exact UTF-8 schema payload. The SDK verifies its byte digest but does not\nsubstitute a generic parser for that schema's actual semantic validator.",
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/ContractRef"
        },
        "sha256": {
          "type": "string"
        },
        "utf8": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "utf8",
        "sha256"
      ]
    },
    "ExtensionHandling": {
      "oneOf": [
        {
          "description": "An operation that needs this block must have the exact interpreter.",
          "type": "string",
          "const": "required"
        },
        {
          "description": "Preserve the payload exactly, including when its schema is understood.",
          "type": "string",
          "const": "preserve"
        },
        {
          "description": "Interpretation is optional; an unknown payload is still preserved.",
          "type": "string",
          "const": "optional"
        }
      ]
    },
    "NativeIdentityDisplay": {
      "description": "Domain-confirmed spelling for presentation, separate from canonical\nmatching. A source reference is optional when the identity is derived.",
      "type": "object",
      "properties": {
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "source"
      ]
    },
    "NativeIdentityEvidence": {
      "type": "object",
      "properties": {
        "display": {
          "$ref": "#/$defs/NativeIdentityDisplay"
        },
        "namespace": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/ContractRef"
        },
        "value": {
          "description": "The domain's canonical matching value, not necessarily its original\nliteral spelling. Core does not normalize this value again.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "namespace",
        "value",
        "policy",
        "display"
      ]
    },
    "NotApplicableBasis": {
      "description": "A trusted capture of an allowed reason and its exact scope basis, not a\nplugin's claim that it is safe to skip a required check.",
      "type": "object",
      "properties": {
        "basisDigest": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "basisDigest"
      ]
    },
    "PluginIdentity": {
      "description": "Claimed package identity; a host must authenticate the actual package source.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "publisher",
        "id",
        "version"
      ]
    },
    "ProtectedFragment": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ContractRef"
        },
        "range": {
          "description": "Coordinates into the decoded unit text, not its original artifact.",
          "$ref": "#/$defs/TextRange"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "range"
      ]
    },
    "ProviderSelectionBinding": {
      "description": "A fixed package/contribution choice, independent of any active instance.\nIts digest is supplied by the trusted package owner; this value neither\nauthenticates those bytes nor grants permission to load or call them.",
      "type": "object",
      "properties": {
        "componentId": {
          "type": "string"
        },
        "contributionId": {
          "type": "string"
        },
        "packageDigest": {
          "type": "string"
        },
        "plugin": {
          "$ref": "#/$defs/PluginIdentity"
        }
      },
      "additionalProperties": false,
      "required": [
        "plugin",
        "componentId",
        "contributionId",
        "packageDigest"
      ]
    },
    "SourceReference": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/TextRange"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifactId",
        "range"
      ]
    },
    "TextEncoding": {
      "type": "string",
      "enum": [
        "utf8-byte",
        "utf16",
        "grapheme"
      ]
    },
    "TextRange": {
      "description": "Half-open offsets into one exact string, never between different strings.",
      "type": "object",
      "properties": {
        "encoding": {
          "$ref": "#/$defs/TextEncoding"
        },
        "end": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "encoding",
        "start",
        "end"
      ]
    }
  }
}
