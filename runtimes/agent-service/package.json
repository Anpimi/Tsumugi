  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
