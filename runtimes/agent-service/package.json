{
  "name": "@tsumugi/agent-service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test --test-timeout=30000 tests/*.test.mjs",
