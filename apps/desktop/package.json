{
  "name": "@tsumugi/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:workbench-preview": "vite --config vite.workbench-preview.config.ts",
    "dev:workbench": "vite --config vite.workbench.config.ts",
    "build:workbench": "tsc --noEmit && vite build --config vite.workbench.config.ts",
    "tauri:workbench": "tauri dev --config src-tauri/tauri.workbench.conf.json",
    "build:workbench-preview": "tsc --noEmit && vite build --config vite.workbench-preview.config.ts",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "lint:workbench": "eslint src/app-v2 && stylelint 'src/app-v2/**/*.css'",
    "check:workbench-contrast": "node scripts/check-workbench-contrast.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.102.5",
    "@tanstack/react-router": "1.170.46",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "cmdk": "1.1.1",
    "i18next": "25.10.10",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "16.6.6",
    "react-resizable-panels": "4.14.6",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@storybook/react-vite": "10.6.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.0",
    "json-schema-to-typescript": "16.0.0",
    "storybook": "10.6.3",
    "stylelint": "17.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
