{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "features": ["bundled-plugins"]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/32x32.png"],
    "resources": {
      "resources/javascript-runtime/tool/": "runtimes/javascript/tool/",
      "resources/javascript-runtime/host/": "runtimes/javascript/host/",
      "resources/bundled-plugins/": "bundled-plugins/",
      "resources/member-runtime/": "member-runtime/"
